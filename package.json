{
  "name": "dsh-kaogong",
  "version": "1.27.0",
  "description": "考公备考整合插件 — 一键式题库管理(必选/推荐/可选分级+镜像代理) · 离线可视化 · 双入口 · SRS错题本 · 花生十三体系方法论(BM25检索+六模块覆盖) · 白盒可观测",
  "homepage": "https://github.com/xuanyuanchumo/dsh-kaogong#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuanyuanchumo/dsh-kaogong.git"
  },
  "bugs": {
    "url": "https://github.com/xuanyuanchumo/dsh-kaogong/issues"
  },
  "type": "module",
  "main": "dist/host/index.js",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-rc.0 <0.3.0-0 || >=0.3.0-rc.0 <0.4.0-0"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-rc.0 <0.3.0-0 || >=0.3.0-rc.0 <0.4.0-0"
  },
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client/client.js",
    "./server": "./dist/server/http.js",
    "./shared": "./dist/shared/manifest.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts",
    "src/shared/types.ts",
    "locale",
    "docs",
    "assets",
    "screenshots.json",
    "icon.svg",
    "cordis.patch.yml",
    "data/study-plan.md",
    "README.md",
    "CLAUDE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-client.mjs && node scripts/assert-combo.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc && node scripts/bundle-client.mjs && node scripts/assert-combo.mjs",
    "prepare": "tsc && node scripts/bundle-client.mjs && node scripts/assert-combo.mjs --fix",
    "postbuild": "node scripts/assert-combo.mjs",
    "test": "tsc && node scripts/bundle-client.mjs && node scripts/assert-combo.mjs && node smoke.test.mjs",
    "test:render": "tsc && node scripts/bundle-client.mjs && node scripts/assert-combo.mjs && node render.test.mjs",
    "test:all": "tsc && node scripts/bundle-client.mjs && node scripts/assert-combo.mjs && node smoke.test.mjs && node render.test.mjs",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "kaogong",
    "考公",
    "公务员",
    "行测",
    "申论",
    "exam",
    "civil-service",
    "srs",
    "methodology",
    "huasheng13",
    "offline-first"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
